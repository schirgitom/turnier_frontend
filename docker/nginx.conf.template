server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass ${NGINX_API_SCHEME}://${NGINX_API_HOST}/api/;
    proxy_ssl_server_name on;
    proxy_set_header Host ${NGINX_API_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /public/tournaments/ {
    proxy_pass ${NGINX_PUBLIC_API_SCHEME}://${NGINX_PUBLIC_API_HOST}/public/tournaments/;
    proxy_ssl_server_name on;
    proxy_set_header Host ${NGINX_PUBLIC_API_HOST};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /hubs/ {
    proxy_pass ${NGINX_HUB_SCHEME}://${NGINX_HUB_HOST}/hubs/;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host ${NGINX_HUB_HOST};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /env.js {
    add_header Cache-Control "no-store";
  }

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok";
  }
}

